{
  "manifest_version": 3,
  "name": "YouTube Shorts Remover",
  "version": "1.0.1",
  "description": "Removes Shorts shelves from YouTube.",
  "content_scripts": [
    {
      "matches": [
        "*://www.youtube.com/*"
      ],
      "js": [
        "contentScript.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html"
  }
}
